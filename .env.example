# Postgres
# Change these before running docker:prod — never reuse the dev defaults in production.
POSTGRES_USER=nexo
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=nexo_centro

# API
NODE_ENV=development
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
DATABASE_URL=postgresql://nexo:change-me-to-a-strong-password@db:5432/nexo_centro
CORS_ORIGIN=http://localhost:5173

# Dev only — enable if HMR misses file changes
CHOKIDAR_USEPOLLING=false
