# Postgres
# Change these before running docker:prod — never reuse the dev defaults in production.
POSTGRES_USER=nexo
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=nexo_centro

# API
NODE_ENV=development
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
# Hostname `db` only resolves inside the Docker network. To run Drizzle
# migrations (db:migrate/db:push/db:studio) from the host, use `localhost`
# instead — see the "Base de dados (Drizzle)" section in README.md.
DATABASE_URL=postgresql://nexo:change-me-to-a-strong-password@db:5432/nexo_centro
CORS_ORIGIN=http://localhost:5173

# Chave de encriptação de segredos at-rest (2FA, etc.) — base64 de 32 bytes.
# Gera com: openssl rand -base64 32
# Obrigatória em produção. NUNCA a mudes sem seguir o fluxo de rotação abaixo
# (perdias a capacidade de desencriptar segredos já gravados).
APP_ENCRYPTION_KEY=

# Versão da chave ativa acima. Sobe sempre que rodas a APP_ENCRYPTION_KEY.
# Default: 1.
APP_ENCRYPTION_KEY_VERSION=1

# Chaves antigas, só para continuar a desencriptar dados gravados antes de uma
# rotação — nunca usadas para encriptar dados novos. Formato:
# "1:<base64>,2:<base64>". Fluxo de rotação: gera uma chave nova, põe-na em
# APP_ENCRYPTION_KEY, sobe APP_ENCRYPTION_KEY_VERSION, move a chave anterior
# para aqui; depois de um job re-encriptar todas as linhas com a chave nova,
# remove a entrada antiga.
APP_ENCRYPTION_KEYS_RETIRED=

# Dev only — enable if HMR misses file changes
CHOKIDAR_USEPOLLING=false

COREPACK_ENABLE_DOWNLOAD_PROMPT=0