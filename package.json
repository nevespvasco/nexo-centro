{
  "name": "@nexo-centro/root",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "md:dev": "pnpm --filter medfolio dev",
    "md-api:dev": "pnpm --filter medfolio-api dev",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:deps": "docker compose run --rm deps",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "db:generate": "pnpm --filter @nexo-centro/db db:generate",
    "db:migrate": "pnpm --filter @nexo-centro/db db:migrate",
    "db:push": "pnpm --filter @nexo-centro/db db:push",
    "db:studio": "pnpm --filter @nexo-centro/db db:studio",
    "db:seed": "pnpm --filter @nexo-centro/db db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "type": "module"
}
